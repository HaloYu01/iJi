<?xml version="1.0" encoding="utf-8"?>
<!--
    自动记账所需的两个能力，权限范围仍然刻意收窄：

    1. 「支付通知自动记账」：只监听通知内容变化，读支付通知的文字。
    2. 「全自动记账」：监听窗口切换与窗口内容变化，并用 canRetrieveWindowContent
       读取当前界面的**文本**，用来在微信 / 支付宝等账单页里认出金额与商户。

    canRetrieveWindowContent=true 的边界：
    - 只在命中监听清单的支付类 App 且当前页符合账单页特征时才读节点树；
    - 只读文本（text / contentDescription），不点击、不输入、不遍历无关应用；
    - 识别结果一律先弹确认，用户点「记录」才写入数据库。

    canTakeScreenshot 只服务「半自动识屏」：用户主动点按钮 / 磁贴 / 音量键时
    取一帧当前画面做 OCR，不会后台自动截屏，图片不出设备。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_payment_desc"
    android:accessibilityEventTypes="typeNotificationStateChanged|typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="200"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds|flagRetrieveInteractiveWindows|flagRequestEnhancedWebAccessibility"
    android:summary="@string/accessibility_payment_label" />
